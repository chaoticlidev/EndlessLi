# EndlessLi environment template. Copy to .env; never commit .env.
# API keys are stored in the OS keychain at runtime (Phase 3); these exist
# only for local development of provider adapters.

# OpenAI-compatible endpoint (optional)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic (optional)
ANTHROPIC_API_KEY=

# DeepSeek (optional)
DEEPSEEK_API_KEY=

# Brave Search (optional; DDGS default needs no key)
BRAVE_SEARCH_API_KEY=

# Self-hosted SearXNG (optional)
SEARXNG_BASE_URL=
